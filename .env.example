# ---- Local development (Postgres running on your machine) ----
# No pooler needed locally — DATABASE_URL and DIRECT_URL can be identical.
# DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/lobby?schema=public"
# DIRECT_URL="postgresql://USER:PASSWORD@localhost:5432/lobby?schema=public"

# ---- Production (Supabase Postgres) ----
# DATABASE_URL = Supabase POOLED connection (port 6543) — what the deployed
# app uses. Append ?pgbouncer=true&connection_limit=1: required when Prisma
# talks to Supabase's connection pooler (PgBouncer) instead of Postgres directly.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = Supabase DIRECT connection (port 5432) — used only for
# `prisma migrate`/`prisma db seed`, which need a non-pooled connection.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
